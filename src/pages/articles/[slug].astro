---
import { getCollection, render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { formatDate, readingTime } from '../../lib/meta';

export async function getStaticPaths() {
  const entries = await getCollection('articles');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Site
  title={`${entry.data.title} | Dara Adedeji`}
  description={entry.data.description}
  image={entry.data.image}
  noindex={entry.data.draft || entry.data.archived}
  section="writing"
>
  <article class="reader">
    <aside class="toc" id="toc" aria-label="Sections"><div class="toc-inner" id="toc-inner"></div></aside>
    <header>
      <div class="kicker">{entry.data.draft ? 'draft · shared for feedback' : entry.data.archived ? 'writing · archived' : 'writing'}</div>
      <h1 class="title">{entry.data.title}</h1>
      {entry.data.description && <p class="desc">{entry.data.description}</p>}
      <div class="meta">{formatDate(entry.data.date)} · {readingTime(entry.body)}</div>
    </header>
    <div class="prose" id="prose">
      <Content />
    </div>
  </article>
</Site>

<script>
  import { sectionMarker } from '../../lib/toc.js';
  const aside = document.getElementById('toc'), inner = document.getElementById('toc-inner'), prose = document.getElementById('prose');
  if (aside && inner && prose) {
    const m = sectionMarker(inner, prose, { reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches });
    if (!m) aside.hidden = true;
  }
</script>
