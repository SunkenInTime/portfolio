---
import { getCollection, render } from 'astro:content';
import Site from '../../layouts/Site.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Site
  title={`${project.data.title} | Dara Adedeji`}
  description={project.data.description}
  image={project.data.image}
  section="work"
>
  <article class="reader">
    <aside class="toc" id="toc" aria-label="Sections"><div class="toc-inner" id="toc-inner"></div></aside>
    <header>
      <div class="kicker">{project.data.timeframe} · {project.data.status}</div>
      <h1 class="title">{project.data.title}</h1>
      <p class="desc">{project.data.tagline}</p>
    </header>
    <div class="prose" id="prose">
      <Content />
    </div>
  </article>
</Site>

<script>
  import { sectionMarker } from '../../lib/toc.js';
  const aside = document.getElementById('toc'), inner = document.getElementById('toc-inner'), prose = document.getElementById('prose');
  if (aside && inner && prose) {
    const m = sectionMarker(inner, prose, { reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches });
    if (!m) aside.hidden = true;
  }
</script>
