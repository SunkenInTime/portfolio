---
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import { formatDate, readingTime } from '../../lib/meta';

const articles = (await getCollection('articles', ({ data }) => !data.draft && !data.archived)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Site title="Writing | Dara Adedeji" section="writing">
  <section class="list">
    <h1>Writing</h1>
    <p class="lead">Devlogs, and occasionally why.</p>
    <div class="entries">
      {articles.map((entry) => (
        <a class="entry" href={`/articles/${entry.id}/`}>
          {entry.data.image ? <img class="cover" src={entry.data.image} alt="" loading="lazy" /> : <span class="cover blank" />}
          <div>
            <div class="when">{formatDate(entry.data.date)} · {readingTime(entry.body)}</div>
            <h2>{entry.data.title}</h2>
            {entry.data.description && <p>{entry.data.description}</p>}
          </div>
        </a>
      ))}
    </div>
  </section>
</Site>
