---
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Site title="Work | Dara Adedeji" section="work">
  <section class="list">
    <h1>Work</h1>
    <p class="lead">Things I built and shipped.</p>
    <div class="entries">
      {projects.map((project) => (
        <a class="entry" href={`/projects/${project.id}/`}>
          {project.data.image ? <img class="cover" src={project.data.image} alt="" loading="lazy" /> : <span class="cover blank" />}
          <div>
            <div class="when">{project.data.timeframe} · {project.data.status}</div>
            <h2>{project.data.title}</h2>
            <p>{project.data.tagline}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Site>
