---
import { getCollection, render } from 'astro:content';
import Site from '../../layouts/Site.astro';

// These URLs are linked from app store listings: the slugs must not change.
export async function getStaticPaths() {
  const pages = await getCollection('legal');
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Site title={`${page.data.title} | Dara Adedeji`}>
  <article class="reader">
    <header>
      <div class="kicker">legal</div>
      <h1 class="title">{page.data.title}</h1>
      {page.data.updated && <div class="meta">{page.data.updated}</div>}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Site>
