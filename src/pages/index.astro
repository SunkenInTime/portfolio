---
import Home from '../layouts/Home.astro';

import { links } from '../lib/links';
---

<Home title="Dara Adedeji">
  <canvas class="flock" id="flock" aria-hidden="true"></canvas>
  <main class="home">
    <div class="me">
      <div class="portrait" id="portrait">
        <canvas id="focus" aria-hidden="true"></canvas>
        <canvas id="ring" aria-hidden="true"></canvas>
        <img src="/images/myProfile.jpg" alt="Dara's avatar, a penguin plush in dungarees" width="223" height="223" />
      </div>
      <h1>Dara Adedeji</h1>
      <p class="line">I build software, film myself doing it, and occasionally write about why.</p>
      <nav aria-label="Sections">
        <a href="/projects/">work</a>
        <a href="/articles/">writing</a>
        <a href="/contact/">contact</a>
      </nav>
    </div>
  </main>

  <footer class="foot">
    <a class="now" id="now" href="#" target="_blank" rel="noopener" aria-live="polite">
      <img alt="" id="now-art" />
      <span><b id="now-track"></b> · <span id="now-artist"></span></span>
      <span class="bar"><i id="now-bar"></i></span>
    </a>
    <div class="links">
      {links.map((l, i) => (
        <>
          {i > 0 && <span>·</span>}
          <a href={l.url} target="_blank" rel="noopener noreferrer me">{l.name}</a>
        </>
      ))}
      <span>·</span>
      <button class="theme" id="theme" type="button" aria-label="Switch theme">dark</button>
    </div>
  </footer>
</Home>

<script>
  import { focusAvatar } from '../lib/soft.js';
  import { albumRing } from '../lib/ring.js';
  import { startFlock } from '../lib/flock.js';
  import { startNowPlaying } from '../lib/now.js';
  import { themeButton } from '../lib/theme.js';

  const portrait = document.getElementById('portrait');
  const canvas = document.getElementById('focus');
  const ringCanvas = document.getElementById('ring');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let ring = null;
  if (portrait && canvas instanceof HTMLCanvasElement && !still) {
    try {
      if (focusAvatar(canvas, '/images/myProfile.jpg')) portrait.classList.add('live');
      if (ringCanvas instanceof HTMLCanvasElement) ring = albumRing(ringCanvas, { reducedMotion: still });
    } catch {
      /* no WebGL: the plain avatar stays, no ring */
    }
  }

  const flockCanvas = document.getElementById('flock');
  const me = document.querySelector('.me');
  const foot = document.querySelector('.foot');
  const flock = !still && flockCanvas instanceof HTMLCanvasElement && me ? startFlock(flockCanvas, foot ? [me, foot] : me) : null;

  const $ = (id) => document.getElementById(id);
  const tb = $('theme'); if (tb) themeButton(tb);
  addEventListener('themechange', () => { if (flock) flock.retheme(); });
  startNowPlaying({ now: $('now'), art: $('now-art'), track: $('now-track'), artist: $('now-artist'), bar: $('now-bar') }, import.meta.env.PUBLIC_API_BASE || '', (t) => {
    if (ring) ring.setTrack(t);
    if (flock) flock.setMusic(t);
    const now = $('now'); if (now) { now.dataset.bpm = t.bpm ? String(t.bpm) : ''; now.dataset.energy = t.energy != null ? t.energy.toFixed(2) : ''; }
  });
</script>
