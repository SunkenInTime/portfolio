---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

// These URLs are linked from app store listings — slugs must not change.
export async function getStaticPaths() {
  const pages = await getCollection('legal');
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<Base title={`${page.data.title} | Dara Adedeji`}>
  <article class="post-single">
    <header class="post-header">
      <h1 class="post-title">{page.data.title}</h1>
      {page.data.updated && <div class="post-meta">{page.data.updated}</div>}
    </header>
    <div class="post-content">
      <Content />
    </div>
    <footer class="post-footer"></footer>
  </article>
</Base>
